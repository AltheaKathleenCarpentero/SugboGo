<!-- Views/Explore/Index.cshtml -->
@{
    ViewData["Title"] = "SugboGo — Cebu like a local";
}

<!-- ========== HERO SECTION (sg-hero) ========== -->
<section class="sg-hero">
    <div class="sg-hero__content">
        <div class="sg-hero__eyebrow">
            <span class="sg-hero__eyebrow-line"></span>
            <span class="sg-label">SugboGo • curated by locals</span>
        </div>
        <h1 class="sg-display-xl sg-hero__title">
            Discover the real <em>Cebu</em>
        </h1>
        <p class="sg-body-lg sg-hero__subtitle">
            From hidden waterfalls to mountain ridges and Cebu's electric city energy —
            experience the island with authentic local guides.
        </p>
        <div class="sg-hero__ctas">
            <a href="/Explore/Tours" class="sg-btn sg-btn--primary sg-btn--lg">Explore experiences →</a>
            <a href="/Explore/Spots" class="sg-btn sg-btn--outline">Trending spots</a>
        </div>
    </div>
    <div class="sg-hero__visual">
        <!-- Replace this entire div -->
        <img class="sg-hero__image" src="~/images/hero-bg.jpg" alt="Kawasan Falls Cebu">
  
        <!-- Keep the overlay card -->
        <div class="sg-hero__overlay-card">
            <div class="sg-caption">Local pick</div>
            <div class="sg-heading">Kawasan canyoneering</div>
            <div class="sg-caption">⭐ 4.9 · 1.2k reviews</div>
        </div>
    </div>
</section>

<!-- ========== STATS BAR ========== -->
<div class="sg-stats-bar">
    <div class="sg-container sg-stats-bar__inner">
        <div class="sg-stat-item">
            <div class="sg-stat-item__number">30+</div>
            <div class="sg-stat-item__label">authentic tours</div>
        </div>
        <div class="sg-stat-item">
            <div class="sg-stat-item__number">1.2k+</div>
            <div class="sg-stat-item__label">happy explorers</div>
        </div>
        <div class="sg-stat-item">
            <div class="sg-stat-item__number">24/7</div>
            <div class="sg-stat-item__label">local support</div>
        </div>
    </div>
</div>

<!-- ========== FEATURED TOUR PACKAGES ========== -->
<section class="sg-section">
    <div class="sg-container">
        <div class="sg-section-header">
            <div>
                <span class="sg-label">SugboGo signature</span>
                <h2 class="sg-display-lg">Adventures you'll remember</h2>
            </div>
            <a href="/Explore/Tours" class="sg-btn sg-btn--ghost">All tours →</a>
        </div>

        <div class="sg-grid-3">
            <!-- Card 1: Kawasan -->
            <article class="sg-tour-card">
                <div class="sg-tour-card__image">
                    <div class="sg-tour-card__image-placeholder" style="background: linear-gradient(145deg, #1F6E6E, #0C4B4B); display: flex; align-items: center; justify-content: center; color: white;">🏞️</div>
                    <span class="sg-tour-card__badge">Best seller</span>
                </div>
                <div class="sg-tour-card__body">
                    <div class="sg-tour-card__category">Canyoneering</div>
                    <h3 class="sg-tour-card__title">Kawasan Falls expedition</h3>
                    <p class="sg-tour-card__desc">Jump, swim, and trek through turquoise gorges. Professional local guides & safety gear included.</p>
                    <div class="sg-tour-card__meta">
                        <span>⏱️ 6-7 hours</span>
                        <span>👥 4-12 pax</span>
                    </div>
                    <div class="sg-tour-card__footer">
                        <div class="sg-tour-card__price">₱2,450 <sub>/person</sub></div>
                        <button class="sg-btn sg-btn--outline sg-btn--sm">Book now</button>
                    </div>
                </div>
            </article>

            <!-- Card 2: Osmeña Peak + Moalboal -->
            <article class="sg-tour-card">
                <div class="sg-tour-card__image">
                    <div class="sg-tour-card__image-placeholder" style="background: linear-gradient(145deg, #2A5F5F, #134141); display: flex; align-items: center; justify-content: center; color: white;">⛰️</div>
                </div>
                <div class="sg-tour-card__body">
                    <div class="sg-tour-card__category">Mountain + sea</div>
                    <h3 class="sg-tour-card__title">Osmeña Peak & Moalboal sardines</h3>
                    <p class="sg-tour-card__desc">Sunrise at Cebu's highest peak, then snorkeling with millions of sardines at Panagsama Beach.</p>
                    <div class="sg-tour-card__meta">
                        <span>⏱️ 10-11 hours</span>
                        <span>👥 2-8 pax</span>
                    </div>
                    <div class="sg-tour-card__footer">
                        <div class="sg-tour-card__price">₱3,250 <sub>/person</sub></div>
                        <button class="sg-btn sg-btn--outline sg-btn--sm">Book now</button>
                    </div>
                </div>
            </article>

            <!-- Card 3: Cebu City historical + Lechon -->
            <article class="sg-tour-card">
                <div class="sg-tour-card__image">
                    <div class="sg-tour-card__image-placeholder" style="background: linear-gradient(145deg, #C4614A, #92412F); display: flex; align-items: center; justify-content: center; color: white;">🍖</div>
                </div>
                <div class="sg-tour-card__body">
                    <div class="sg-tour-card__category">Food & heritage</div>
                    <h3 class="sg-tour-card__title">Lechon legacy + heritage tour</h3>
                    <p class="sg-tour-card__desc">Temple of Leah, Magellan's Cross, and the best roasted pig in Cebu (with 3 lechon stops).</p>
                    <div class="sg-tour-card__meta">
                        <span>⏱️ 5 hours</span>
                        <span>👥 Private</span>
                    </div>
                    <div class="sg-tour-card__footer">
                        <div class="sg-tour-card__price">₱1,990 <sub>/person</sub></div>
                        <button class="sg-btn sg-btn--outline sg-btn--sm">Book now</button>
                    </div>
                </div>
            </article>
        </div>
    </div>
</section>

<!-- ========== HIKING FEATURE (mix large + small cards) ========== -->
<section class="sg-section sg-section--beige">
    <div class="sg-container">
        <div class="sg-section-header">
            <div>
                <span class="sg-label">For mountain lovers</span>
                <h2 class="sg-display-lg">Hiking trails less travelled</h2>
            </div>
            <a href="/Explore/Hiking" class="sg-btn sg-btn--ghost">See all trails →</a>
        </div>

        <div class="sg-hiking-featured">
            <!-- Featured trail card (large) -->
            <div class="sg-trail-card--featured">
                <div class="sg-trail-bg"></div>
                <div class="sg-trail-content">
                    <span class="sg-label">⛰️ Central Cebu</span>
                    <h3 class="sg-heading">Osmeña Peak sunrise trek</h3>
                    <p class="sg-body">The rooftop of Cebu — endless rolling hills & refreshing pre-dawn hikes. Perfect for beginners & pros.</p>
                    <span class="sg-badge sg-badge--easy">Easy to moderate</span>
                    <div class="sg-trail-stats">
                        <span>📍 1.5h drive from Moalboal</span>
                        <span>⏱️ 2h round trip</span>
                    </div>
                </div>
            </div>

            <div class="sg-trail-info-panel">
                <!-- small trail card 1 -->
                <div class="sg-trail-card--sm">
                    <div class="sg-trail-thumb">
                        <div style="background: #154E4E; width:100%; height:100%; display: flex; align-items: center; justify-content: center; color: white;">🌿</div>
                    </div>
                    <div class="sg-trail-body">
                        <span class="sg-badge sg-badge--moderate">Moderate</span>
                        <h4 class="sg-heading">Mt. Kan-irag (Sirao Peak)</h4>
                        <p class="sg-caption">Famous "Little Batanes" & flower farms.</p>
                        <div class="sg-trail-stats">
                            <span>↗️ 560m</span>
                            <span>⏱️ 1h30</span>
                        </div>
                    </div>
                </div>
                <!-- small trail card 2 -->
                <div class="sg-trail-card--sm">
                    <div class="sg-trail-thumb">
                        <div style="background: #2A8A8A; width:100%; height:100%; display: flex; align-items: center; justify-content: center; color: white;">🏔️</div>
                    </div>
                    <div class="sg-trail-body">
                        <span class="sg-badge sg-badge--challenging">Challenging</span>
                        <h4 class="sg-heading">Mt. Naupa (Badian)</h4>
                        <p class="sg-caption">Dramatic limestone ridges + sea views.</p>
                        <div class="sg-trail-stats">
                            <span>↗️ 780m</span>
                            <span>⏱️ 3h</span>
                        </div>
                    </div>
                </div>
                <!-- small trail card 3 -->
                <div class="sg-trail-card--sm">
                    <div class="sg-trail-thumb">
                        <div style="background: #C4614A; width:100%; height:100%; display: flex; align-items: center; justify-content: center; color: white;">🌋</div>
                    </div>
                    <div class="sg-trail-body">
                        <span class="sg-badge sg-badge--hard">Hard</span>
                        <h4 class="sg-heading">Mt. Manunggal</h4>
                        <p class="sg-caption">Presidential crash site + 360° mountain views.</p>
                        <div class="sg-trail-stats">
                            <span>↗️ 1,000m</span>
                            <span>⏱️ 4h</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ========== GASTRO (Cebu culinary) ========== -->
<section class="sg-section">
    <div class="sg-container">
        <div class="sg-section-header">
            <div>
                <span class="sg-label">Taste the island</span>
                <h2 class="sg-display-lg">Cebu's iconic bites & hideouts</h2>
            </div>
            <a href="/Explore/Gastronomy" class="sg-btn sg-btn--ghost">Explore food trips →</a>
        </div>
        <div class="sg-gastro-grid">
            <div class="sg-gastro-card">
                <div class="sg-gastro-card__bg"></div>
                <div class="sg-gastro-card__overlay"></div>
                <div class="sg-gastro-card__body">
                    <div class="sg-gastro-card__title">Lechon Cebu</div>
                    <div class="sg-gastro-card__sub">Rick Bayless' favorite · Carcar</div>
                </div>
            </div>
            <div class="sg-gastro-card">
                <div class="sg-gastro-card__bg"></div>
                <div class="sg-gastro-card__overlay"></div>
                <div class="sg-gastro-card__body">
                    <div class="sg-gastro-card__title">Ngohiong Express</div>
                    <div class="sg-gastro-card__sub">Cebu's spring roll sensation</div>
                </div>
            </div>
            <div class="sg-gastro-card">
                <div class="sg-gastro-card__bg"></div>
                <div class="sg-gastro-card__overlay"></div>
                <div class="sg-gastro-card__body">
                    <div class="sg-gastro-card__title">Pungko-pungko</div>
                    <div class="sg-gastro-card__sub">Fried street food at Fuente</div>
                </div>
            </div>
            <div class="sg-gastro-card">
                <div class="sg-gastro-card__bg"></div>
                <div class="sg-gastro-card__overlay"></div>
                <div class="sg-gastro-card__body">
                    <div class="sg-gastro-card__title">Tuslob Buwa</div>
                    <div class="sg-gastro-card__sub">Pig brain dip · Pasil style</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ========== FEATURE STRIP: WHY CEBU ========== -->
<section class="sg-section sg-section--beige">
    <div class="sg-container">
        <div class="sg-text-center sg-mb-lg">
            <span class="sg-label">Why local love</span>
            <h2 class="sg-display-md">Cebu is more than a stopover</h2>
        </div>
        <div class="sg-features-grid">
            <div class="sg-feature-item">
                <div class="sg-feature-icon">🌊</div>
                <h3 class="sg-heading">300+ islands nearby</h3>
                <p class="sg-caption">Cebu’s location unlocks the Visayas — from Malapascua to Camotes.</p>
            </div>
            <div class="sg-feature-item">
                <div class="sg-feature-icon">🍜</div>
                <h3 class="sg-heading">Unmatched food scene</h3>
                <p class="sg-caption">From lechon to pungko-pungko, Cebu owns the flavor.</p>
            </div>
            <div class="sg-feature-item">
                <div class="sg-feature-icon">⛰️</div>
                <h3 class="sg-heading">Mountains meet sea</h3>
                <p class="sg-caption">Trek in the morning, dive in the afternoon — all in one island.</p>
            </div>
        </div>
    </div>
</section>

<!-- ========== NEWSLETTER / CTA ========== -->
<section class="sg-newsletter">
    <div class="sg-container sg-newsletter__inner">
        <span class="sg-label">Newsletter</span>
        <div class="sg-display-md">Get Cebu secrets straight to your inbox</div>
        <p class="sg-body">Monthly updates on hidden falls, food finds, and local-only discounts.</p>
        <form class="sg-newsletter__form">
            <input type="email" class="sg-newsletter__input" placeholder="Your email address" required>
            <button type="submit" class="sg-btn sg-btn--primary">Subscribe →</button>
        </form>
    </div>
</section>