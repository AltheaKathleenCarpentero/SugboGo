@{
    ViewData["Title"] = "Journey Timeline";

    var itinerary = new[] {
        new {
            Time = "Day 1, 3:00 PM",
            Category = "Boutique stay",
            Title = "The Helix House",
            Location = "Banawa ridge",
            Duration = "2 nights",
            Price = "PHP 8,900",
            Note = "Design-led hill stay with late checkout, airport transfer, and a private balcony breakfast.",
            Includes = "King studio, welcome drinks, breakfast for two, transfer coordination"
        },
        new {
            Time = "Day 2, 6:10 AM",
            Category = "Hidden water",
            Title = "Talisay Blue Hour Cove",
            Location = "South Cebu coast",
            Duration = "7 hours",
            Price = "PHP 4,800",
            Note = "A low-crowd beach route timed around tide windows, with a local guide and picnic stop.",
            Includes = "Private van, guide, reef shoes, towel kit, packed brunch"
        },
        new {
            Time = "Day 2, 7:30 PM",
            Category = "Secret table",
            Title = "The Red Door Supper Club",
            Location = "Cebu City",
            Duration = "2.5 hours",
            Price = "PHP 3,200",
            Note = "A chef-hosted dinner in a restored ancestral home, matched to your quiz preference for smoky seafood and quiet rooms.",
            Includes = "Five-course menu, calamansi aperitif, table deposit, return ride"
        },
        new {
            Time = "Day 3, 9:00 AM",
            Category = "Soft adventure",
            Title = "Osmena Dawn Trail Reset",
            Location = "Dalaguete",
            Duration = "5 hours",
            Price = "PHP 2,900",
            Note = "A gentle peak walk with a local naturalist, coffee at the ridge, and flexible pacing.",
            Includes = "Guide, permit, trail snacks, rain shell, photo stops"
        }
    };
}

<section class="booking-flow" data-booking-flow>
    <div class="booking-shell">
        <div class="booking-hero lp-reveal">
            <p class="lp-kicker">Vibe Quiz complete</p>
            <div class="booking-hero__grid">
                <div>
                    <h1>Your Cebu Journey Timeline</h1>
                    <p>Four curated gems, ordered by arrival time and tuned for a flashpacker rhythm: comfort first, surprise close behind.</p>
                </div>
                <aside class="booking-summary" aria-label="Journey summary">
                    <span>3 days</span>
                    <strong>PHP 19,800</strong>
                    <small>Includes local coordination, partner holds, and digital passes.</small>
                </aside>
            </div>
        </div>

        <div class="booking-progress lp-reveal" aria-label="Booking progress">
            <span class="is-active" data-progress-step="review">Review</span>
            <span data-progress-step="payment">Quick-Pay</span>
            <span data-progress-step="success">Passes</span>
        </div>

        <div class="booking-stage is-active" data-stage="review">
            <div class="journey-layout">
                <div class="journey-timeline lp-reveal" aria-label="Curated itinerary timeline">
                    @for (var i = 0; i < itinerary.Length; i++)
                    {
                        var item = itinerary[i];
                        <article class="journey-item" data-journey-item>
                            <div class="journey-item__pin">
                                <span>@(i + 1)</span>
                            </div>
                            <div class="journey-item__body">
                                <div class="journey-item__topline">
                                    <span>@item.Time</span>
                                    <span>@item.Category</span>
                                </div>
                                <div class="journey-item__main">
                                    <div>
                                        <h2 data-item-title>@item.Title</h2>
                                        <p>@item.Location • @item.Duration</p>
                                    </div>
                                    <strong>@item.Price</strong>
                                </div>
                                <details class="journey-details">
                                    <summary>Details</summary>
                                    <p>@item.Note</p>
                                    <small>@item.Includes</small>
                                </details>
                                <div class="journey-item__actions">
                                    <button class="booking-link-btn" type="button" data-swap-button>Swap</button>
                                    <span data-swap-note>AI matched from your beach, design, and food signals.</span>
                                </div>
                            </div>
                        </article>
                    }
                </div>

                <aside class="checkout-panel lp-reveal">
                    <p class="lp-kicker">Trip hold</p>
                    <h2>Ready to lock the route?</h2>
                    <dl>
                        <div><dt>Experiences</dt><dd>4 curated stops</dd></div>
                        <div><dt>Travelers</dt><dd>2 guests</dd></div>
                        <div><dt>Due now</dt><dd>PHP 19,800</dd></div>
                    </dl>
                    <button class="booking-primary" type="button" data-next-stage="payment">Continue to Quick-Pay</button>
                    <p>Partner holds release in 18 minutes. You can still swap gems before payment.</p>
                </aside>
            </div>
        </div>

        <div class="booking-stage" data-stage="payment" aria-hidden="true">
            <div class="flash-checkout">
                <section class="flash-checkout__form" aria-labelledby="checkout-title">
                    <p class="lp-kicker">Flashpacker checkout</p>
                    <h2 id="checkout-title">One page, no friction.</h2>

                    <div class="quick-pay" aria-label="Quick pay options">
                        <button type="button" data-pay-method="Apple Pay">Apple Pay</button>
                        <button type="button" data-pay-method="Google Pay">Google Pay</button>
                        <button type="button" data-pay-method="Stripe">Stripe</button>
                    </div>

                    <div class="booking-divider"><span>or confirm traveler details</span></div>

                    <form class="checkout-form" data-checkout-form>
                        <label>
                            Full name
                            <input type="text" value="Mika Santos" autocomplete="name" />
                        </label>
                        <label>
                            Email
                            <input type="email" value="mika@sogbogo.test" autocomplete="email" />
                        </label>
                        <label>
                            Mobile
                            <input type="tel" value="+63 917 000 2841" autocomplete="tel" />
                        </label>
                        <label>
                            Card
                            <input type="text" value="4242 4242 4242 4242" inputmode="numeric" />
                        </label>
                        <div class="checkout-form__row">
                            <label>
                                Expiry
                                <input type="text" value="08 / 29" inputmode="numeric" />
                            </label>
                            <label>
                                CVC
                                <input type="text" value="248" inputmode="numeric" />
                            </label>
                        </div>
                        <button class="booking-primary" type="submit">Pay PHP 19,800</button>
                    </form>
                </section>

                <aside class="payment-recap">
                    <p class="lp-kicker">Included today</p>
                    <ul>
                        <li>All partner reservations held instantly</li>
                        <li>Digital passes and QR codes issued after payment</li>
                        <li>One SogboGo concierge thread for schedule changes</li>
                    </ul>
                    <button class="booking-link-btn" type="button" data-next-stage="review">Back to timeline</button>
                </aside>
            </div>
        </div>

        <div class="booking-stage" data-stage="success" aria-hidden="true">
            <section class="success-state">
                <div class="success-state__copy">
                    <p class="lp-kicker">Confirmed in 28 seconds</p>
                    <h2>Your Adventure is Ready</h2>
                    <p>The full Cebu route is now live. We sent your digital pass bundle, pickup windows, and host notes to your email and mobile.</p>
                    <a class="booking-primary" href="/">Back to SogboGo</a>
                </div>
                <div class="pass-stack" aria-label="Digital pass previews">
                    @foreach (var pass in new[] { ("Stay", "HELIX-18A"), ("Tour", "COVE-42Q"), ("Dinner", "RED-09K") })
                    {
                        <article class="digital-pass">
                            <span>@pass.Item1</span>
                            <strong>@pass.Item2</strong>
                            <div class="qr-preview" aria-label="QR preview">
                                @for (var cell = 0; cell < 25; cell++)
                                {
                                    <i class="@(((cell + pass.Item2.Length) % 3 == 0 || cell == 0 || cell == 4 || cell == 20 || cell == 24) ? "is-filled" : "")"></i>
                                }
                            </div>
                        </article>
                    }
                </div>
            </section>
        </div>
    </div>
</section>
