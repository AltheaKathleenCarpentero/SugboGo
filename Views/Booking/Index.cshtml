@model BookingStepViewModel

@{
    ViewData["Title"] = $"Book {Model.Data.DestinationName}";
    var minDate = DateTime.Today.AddDays(1).ToString("yyyy-MM-dd");
    var defaultDate = DateTime.Today.AddDays(7).ToString("yyyy-MM-dd");
    var profileSummary = Model.Preferences is null
        ? "Traveler profile pending. Complete the preference survey for sharper recommendations."
        : $"{Model.Preferences.BudgetRange}, {Model.Preferences.TravelPace} pace, adventure {Model.Preferences.AdventureLevel}/5";
}

<section class="booking-flow" data-booking-wizard data-destination="@Model.Data.DestinationName" data-base-price="@Model.Data.BasePrice" data-image-url="@Model.Data.ImageUrl" data-location="@Model.Data.Location">
    @Html.AntiForgeryToken()

    <div class="booking-shell">
        <header class="booking-hero lp-reveal">
            <div class="booking-hero__grid">
                <div>
                    <p class="lp-kicker">Secure Cebu booking</p>
                    <h1>@Model.Data.DestinationName</h1>
                    <p>@Model.Data.Description</p>
                </div>
                <aside class="booking-summary" aria-label="Destination overview">
                    <span>@Model.Data.RatingSummary</span>
                    <strong>PHP @Model.Data.BasePrice.ToString("N0")</strong>
                    <small>@Model.Data.Location · @Model.Data.Duration</small>
                    <small>Best time: @Model.Data.BestTimeToVisit</small>
                </aside>
            </div>
        </header>

        <nav class="booking-progress lp-reveal" aria-label="Booking progress">
            <span class="is-active" data-step-indicator="config">1. Trip details</span>
            <span data-step-indicator="review">2. Review</span>
            <span data-step-indicator="payment">3. Payment</span>
            <span data-step-indicator="success">4. QR pass</span>
        </nav>

        <section class="booking-stage is-active" data-booking-step="config">
            <div class="journey-layout">
                <main class="journey-timeline" aria-label="Booking options">
                    <article class="journey-item">
                        <div class="journey-item__pin"><span>A</span></div>
                        <div class="journey-item__body">
                            <div class="journey-item__topline"><span>Travel date</span><strong>Weather-aware</strong></div>
                            <div class="booking-form-grid">
                                <label>
                                    <span>Choose a date</span>
                                    <input type="date" name="travelDate" value="@defaultDate" min="@minDate" required />
                                    <small>Peak indicators and pre-trip weather reminders are attached to the booking record.</small>
                                </label>
                                <label>
                                    <span>Traveler group</span>
                                    <select name="travelerType">
                                        <option value="Solo" data-count="1">Solo</option>
                                        <option value="Couple" data-count="2">Couple</option>
                                        <option value="Group" data-count="4">Group</option>
                                        <option value="Family" data-count="4">Family</option>
                                    </select>
                                </label>
                            </div>
                        </div>
                    </article>

                    <article class="journey-item">
                        <div class="journey-item__pin"><span>B</span></div>
                        <div class="journey-item__body">
                            <div class="journey-item__topline"><span>Activities</span><strong>Add-ons</strong></div>
                            <div class="booking-option-list">
                                @foreach (var activity in Model.ActivityOptions)
                                {
                                    <label class="booking-choice">
                                        <input type="checkbox" name="activities" value="@activity.Name" data-price="@activity.Price" />
                                        <span>
                                            <strong>@activity.Name</strong>
                                            <small>@activity.Description</small>
                                        </span>
                                        <b>PHP @activity.Price.ToString("N0")</b>
                                    </label>
                                }
                            </div>
                        </div>
                    </article>

                    <article class="journey-item">
                        <div class="journey-item__pin"><span>C</span></div>
                        <div class="journey-item__body">
                            <div class="journey-item__topline"><span>Accommodation</span><strong>Stay type</strong></div>
                            <div class="booking-option-list booking-option-list--media">
                                @foreach (var stay in Model.AccommodationOptions)
                                {
                                    <label class="booking-choice booking-choice--media">
                                        <input type="radio" name="accommodation" value="@stay.Name" data-price="@stay.PricePerNight" @(stay.PricePerNight == 0 ? "checked" : null) />
                                        <img src="@stay.ImageUrl" alt="@stay.Name" />
                                        <span>
                                            <strong>@stay.Name</strong>
                                            <small>@stay.Type · @stay.Amenities · @stay.Distance · @stay.Rating rating</small>
                                        </span>
                                        <b>@(stay.PricePerNight == 0 ? "Included" : $"PHP {stay.PricePerNight:N0}")</b>
                                    </label>
                                }
                            </div>
                        </div>
                    </article>

                    <article class="journey-item">
                        <div class="journey-item__pin"><span>D</span></div>
                        <div class="journey-item__body">
                            <div class="journey-item__topline"><span>Transportation</span><strong>Route support</strong></div>
                            <div class="booking-option-list">
                                @foreach (var transport in Model.TransportOptions)
                                {
                                    <label class="booking-choice">
                                        <input type="radio" name="transportation" value="@transport.Name" data-price="@transport.Price" @(transport.Price == 0 ? "checked" : null) />
                                        <span>
                                            <strong>@transport.Name</strong>
                                            <small>@transport.Details</small>
                                        </span>
                                        <b>@(transport.Price == 0 ? "Included" : $"PHP {transport.Price:N0}")</b>
                                    </label>
                                }
                            </div>
                        </div>
                    </article>

                    <article class="journey-item">
                        <div class="journey-item__pin"><span>E</span></div>
                        <div class="journey-item__body">
                            <div class="journey-item__topline"><span>Traveler notes</span><strong>Optional</strong></div>
                            <label class="booking-notes">
                                <span>Anything we should know before your trip?</span>
                                <textarea name="travelerNotes" rows="4" placeholder="Vegetarian meals, avoid rough boat rides, anniversary trip, beginner swimmer..."></textarea>
                            </label>
                            <div class="journey-item__actions">
                                <span>@profileSummary</span>
                                <button type="button" class="booking-link-btn" data-goto-step="review">Review booking</button>
                            </div>
                        </div>
                    </article>
                </main>

                <aside class="checkout-panel lp-reveal">
                    <h2>Live price</h2>
                    <dl>
                        <div><dt>Base experience</dt><dd>PHP <span data-base-display>@Model.Data.BasePrice.ToString("N0")</span></dd></div>
                        <div data-add-ons-row hidden><dt>Add-ons</dt><dd>PHP <span data-addons-display>0</span></dd></div>
                        <div><dt>Taxes and fees</dt><dd>PHP <span data-taxes-display>0</span></dd></div>
                        <div><dt>Total</dt><dd>PHP <span data-total-display>@Model.Data.BasePrice.ToString("N0")</span></dd></div>
                    </dl>
                    <p>@Model.SmartRecommendations.FirstOrDefault()</p>
                    <div class="booking-rec-list">
                        @foreach (var rec in Model.SmartRecommendations.Skip(1))
                        {
                            <small>@rec</small>
                        }
                    </div>
                </aside>
            </div>
        </section>

        <section class="booking-stage" data-booking-step="review">
            <div class="journey-layout">
                <main class="flash-checkout__form">
                    <h2>Review booking</h2>
                    <div class="review-summary" data-review-summary></div>
                    <div class="journey-item__actions">
                        <button type="button" class="booking-link-btn" data-goto-step="config">Back to options</button>
                        <button type="button" class="booking-link-btn" data-goto-step="payment">Proceed to payment</button>
                    </div>
                </main>
                <aside class="checkout-panel">
                    <h2>Map and timing</h2>
                    <div class="booking-map">
                        <iframe title="@Model.Data.DestinationName map" src="@Model.Data.MapUrl" loading="lazy"></iframe>
                    </div>
                    <p>Admin receives this booking instantly after payment confirmation.</p>
                </aside>
            </div>
        </section>

        <section class="booking-stage" data-booking-step="payment">
            <div class="flash-checkout">
                <main class="flash-checkout__form">
                    <h2>Secure payment</h2>
                    <div class="quick-pay">
                        <button type="button" data-pay-method="GCash">GCash</button>
                        <button type="button" data-pay-method="Maya">Maya</button>
                        <button type="button" data-pay-method="Card">Card</button>
                        <button type="button" data-pay-method="PayPal">PayPal</button>
                    </div>
                    <div class="booking-divider"><span>Encrypted checkout simulation</span></div>
                    <div class="payment-sim" data-payment-sim hidden>
                        <p>Processing payment and writing the booking to Supabase PostgreSQL...</p>
                    </div>
                </main>
                <aside class="payment-recap">
                    <h2>Protection</h2>
                    <ul>
                        <li>Secure checkout token attached to the booking.</li>
                        <li>QR verification code generated after payment.</li>
                        <li>Digital itinerary appears in the traveler dashboard.</li>
                    </ul>
                </aside>
            </div>
        </section>

        <section class="booking-stage" data-booking-step="success">
            <div class="success-state">
                <div class="success-state__copy">
                    <p class="lp-kicker">Booking confirmed</p>
                    <h2>Your Cebu trip is locked in.</h2>
                    <p>Use the QR pass at check-in. The same booking now appears in admin operations and your dashboard.</p>
                    <a href="/Dashboard" class="booking-primary">Open trip dashboard</a>
                </div>
                <div class="pass-stack">
                    <article class="digital-pass">
                        <div><span>Booking ID</span><strong data-conf-id>Pending</strong></div>
                        <div class="qr-preview" data-qr-code-placeholder aria-label="QR code preview"></div>
                    </article>
                    <article class="digital-pass">
                        <div><span>Destination</span><strong>@Model.Data.DestinationName</strong></div>
                    </article>
                    <article class="digital-pass">
                        <div><span>Support</span><strong>Weather, checklist, emergency contacts</strong></div>
                    </article>
                </div>
            </div>
        </section>
    </div>
</section>
