@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    var activeTrip = Model.ActiveTrip;
    var mapCenter = activeTrip?.MapPins.FirstOrDefault();
    var mapUrl = mapCenter is null
        ? "https://www.openstreetmap.org/export/embed.html?bbox=123.82%2C10.24%2C123.98%2C10.40&layer=mapnik"
        : $"https://www.openstreetmap.org/export/embed.html?bbox=123.82%2C10.24%2C123.98%2C10.40&layer=mapnik&marker={mapCenter.Latitude}%2C{mapCenter.Longitude}";
}

<section class="dash-page" data-dashboard>
    <div class="dash-shell">
        <header class="dash-topbar lp-reveal">
            <div>
                <p class="lp-kicker">SogboGo Dashboard</p>
                <h1>@Model.Greeting</h1>
            </div>
            <div class="dash-topbar__actions">
                <a class="dash-icon-btn" href="#notifications" aria-label="Notifications">3</a>
                <a class="dash-profile-chip" href="#profile">@Model.FirstName.Substring(0, 1)</a>
            </div>
        </header>

        @if (activeTrip is not null)
        {
            <section class="dash-hero lp-reveal" aria-label="Active trip">
                <div class="dash-hero__content">
                    <p class="dash-status">@activeTrip.Status</p>
                    <h2>@activeTrip.Title</h2>
                    <p class="dash-trip-meta">@activeTrip.DateRange • @activeTrip.Hotel</p>

                    <div class="dash-itinerary" aria-label="Quick-access itinerary">
                        @foreach (var stop in activeTrip.Stops)
                        {
                            <article class="dash-stop">
                                <time>@stop.Time</time>
                                <div>
                                    <strong>@stop.Title</strong>
                                    <span>@stop.Type • @stop.Location</span>
                                </div>
                                <small>@stop.PartnerStatus</small>
                            </article>
                        }
                    </div>

                    <div class="dash-hero__actions">
                        <a class="dash-primary" href="@activeTrip.ConciergeUrl" target="_blank" rel="noreferrer">Help me now</a>
                        <button class="dash-secondary" type="button" data-surprise-button>Surprise Me</button>
                    </div>
                </div>

                <aside class="dash-hero__side">
                    <div class="sogbo-key" aria-label="Sogbo-Key digital pass">
                        <span>Sogbo-Key</span>
                        <strong>@activeTrip.SogboKeyCode</strong>
                        <div class="sogbo-key__qr" aria-label="Digital pass QR code">
                            @for (var cell = 0; cell < 49; cell++)
                            {
                                <i class="@(((cell + activeTrip.SogboKeyCode.Length) % 4 == 0 || cell is 0 or 1 or 7 or 8 or 40 or 48) ? "is-filled" : "")"></i>
                            }
                        </div>
                        <small>Show this at partner spots for priority access and SogboGo perks.</small>
                    </div>
                </aside>
            </section>

            <section class="dash-map-section lp-reveal" aria-label="Trip map">
                <div class="dash-section-head">
                    <p class="lp-kicker">Today on the map</p>
                    <h2>Your route, timed around Cebu traffic and comfort windows.</h2>
                </div>
                <div class="dash-map">
                    <iframe title="Cebu itinerary map" src="@mapUrl" loading="lazy"></iframe>
                    <div class="dash-map__overlay" aria-hidden="true">
                        @foreach (var pin in activeTrip.MapPins)
                        {
                            <span class="dash-map-pin" style="--x:@pin.X%; --y:@pin.Y%;">
                                <b>@pin.Time</b>
                                @pin.Label
                            </span>
                        }
                    </div>
                </div>
            </section>
        }
        else
        {
            <section class="dash-empty-trip lp-reveal">
                <p class="lp-kicker">No active trip yet</p>
                <h2>Let’s build your next Cebu vibe.</h2>
                <p>Your dashboard will turn into a live concierge once you book a curated route.</p>
                <a class="dash-primary" asp-controller="Booking" asp-action="Index">Start Planning</a>
            </section>
        }

        <section class="dash-discovery lp-reveal" aria-label="Personalized discovery">
            <div class="dash-section-head">
                <p class="lp-kicker">Discovery</p>
                <h2>Refine your vibe</h2>
                <p>Still feeling the Urban Explorer vibe? These hidden gems were matched to your stay, food, and pace preferences.</p>
            </div>

            <div class="dash-vibe-tags" aria-label="Vibe tags">
                @foreach (var tag in Model.VibeTags)
                {
                    <button class="@(tag.IsActive ? "is-active" : "")" type="button" data-vibe-tag>@tag.Label</button>
                }
            </div>

            <div class="dash-gem-grid">
                @foreach (var gem in Model.CuratedGems)
                {
                    <article class="dash-gem-card" data-surprise-gem data-title="@gem.Title" data-reason="@gem.MatchReason">
                        <img src="@gem.ImageUrl" alt="@gem.Title in @gem.Neighborhood" />
                        <div>
                            <span>@gem.Category • @gem.MatchScore% match</span>
                            <h3>@gem.Title</h3>
                            <p>@gem.MatchReason</p>
                            <small>@gem.Neighborhood</small>
                        </div>
                    </article>
                }
            </div>

            <div class="dash-surprise" data-surprise-panel hidden>
                <span>Today’s hidden gem</span>
                <strong data-surprise-title></strong>
                <p data-surprise-reason></p>
            </div>
        </section>

        <section class="dash-vault lp-reveal" aria-label="Vault">
            <div class="dash-section-head">
                <p class="lp-kicker">Vault</p>
                <h2>Bookings, saved gems, and past adventures.</h2>
            </div>

            <div class="dash-vault-grid">
                <article class="dash-vault-card">
                    <h3>My Bookings</h3>
                    @if (Model.Bookings.Any())
                    {
                        <ul>
                            @foreach (var booking in Model.Bookings)
                            {
                                <li><strong>@booking.Type</strong><span>@booking.Title</span><small>@booking.Date • @booking.Status</small></li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>No bookings yet. Your confirmed hotels, activities, and transfers will appear here.</p>
                    }
                </article>

                <article class="dash-vault-card">
                    <h3>Saved Gems</h3>
                    <ul>
                        @foreach (var gem in Model.SavedGems)
                        {
                            <li><strong>@gem.Title</strong><span>@gem.Note</span></li>
                        }
                    </ul>
                </article>

                <article class="dash-vault-card">
                    <h3>Past Adventures</h3>
                    @if (Model.PastAdventures.Any())
                    {
                        <ul>
                            @foreach (var adventure in Model.PastAdventures)
                            {
                                <li><strong>@adventure.Title</strong><span>@adventure.Date</span></li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>Your return-worthy Cebu stories will collect here after your first trip.</p>
                    }
                </article>
            </div>
        </section>

        <section class="dash-preferences lp-reveal" id="profile" aria-label="Account and preferences">
            <div class="dash-section-head">
                <p class="lp-kicker">Account and preferences</p>
                <h2>Your Flashpacker profile</h2>
            </div>

            <div class="dash-preference-grid">
                <article><span>Travel Profile</span><strong>@Model.TravelProfile.StayPreference</strong><p>@Model.TravelProfile.FoodPreference</p><p>@Model.TravelProfile.PacePreference</p></article>
                <article><span>Payment Methods</span><strong>@Model.TravelProfile.PaymentSummary</strong><p>Quick-Pay is ready for seamless booking holds.</p></article>
                <article id="notifications"><span>Notifications</span><strong>@Model.TravelProfile.Notifications</strong><p>We will prioritize route changes, weather swaps, and partner readiness.</p></article>
            </div>
        </section>

        <section class="dash-features lp-reveal" aria-label="Suggested features">
            <div class="dash-section-head">
                <p class="lp-kicker">Suggested next features</p>
                <h2>What would make SogboGo feel even more high-touch.</h2>
            </div>
            <div class="dash-feature-grid">
                @foreach (var feature in Model.FeatureSuggestions)
                {
                    <article>
                        <h3>@feature.Title</h3>
                        <p>@feature.Description</p>
                    </article>
                }
            </div>
        </section>
    </div>

    <a class="dash-floating-chat" href="https://wa.me/639170002841" target="_blank" rel="noreferrer">Chat with SogboGo</a>
</section>
